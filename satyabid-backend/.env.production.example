# Production environment variables for the SatyaBid Flask backend.
# On Render: set these in the Environment → Environment Variables panel.
# Do NOT commit a .env file containing real secrets to source control.

# Set to 0 in production — disables Flask's interactive debugger and reloader.
FLASK_DEBUG=0

# Port is injected automatically by Render — do NOT set PORT manually.
# The start command uses: gunicorn api:app --workers 2 --bind 0.0.0.0:$PORT

# Set a strong random secret in the Render dashboard.
# In render.yaml, API_KEY is marked sync: false so Render will not auto-generate
# or overwrite it — you must set it manually once and it will persist across deploys.
API_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# Comma-separated list of allowed frontend origins.
# Set this to your actual Netlify URL after the frontend is deployed.
# Example: CORS_ORIGINS=https://satyabid.netlify.app
CORS_ORIGINS=https://satyabid.netlify.app
