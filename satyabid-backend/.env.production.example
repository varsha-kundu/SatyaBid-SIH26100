# Production environment variables for the SatyaBid Flask backend.
# On Render: set these in the Environment → Environment Variables panel.
# Do NOT commit a .env file containing real secrets to source control.

# Set to 0 in production — disables Flask's interactive debugger and reloader.
FLASK_DEBUG=0

# Port Render assigns — Render injects $PORT automatically; keep this as 8000
# as a local fallback only.
PORT=8000

# Generate a strong random secret for production — never use "SIH2026" in prod.
# On Render the render.yaml already marks this as generateValue: true.
API_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# Comma-separated list of allowed frontend origins.
# Replace with your actual Netlify URL after you know it.
# Example: CORS_ORIGINS=https://satyabid.netlify.app,https://deploy-preview-1--satyabid.netlify.app
CORS_ORIGINS=https://satyabid.netlify.app
