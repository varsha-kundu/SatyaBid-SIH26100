# Copy this file to `.env` and set a secure key before running the service locally.
# Do NOT commit .env with a real key to source control.

# Set to 1 for local development (enables Flask reloader and debugger).
# Set to 0 for production.
FLASK_DEBUG=1

# Local fallback port. Render injects PORT automatically in production.
PORT=8000

# The API key the backend checks on every authenticated request (X-API-KEY header).
# Must match VITE_API_KEY in the frontend .env.
API_KEY=REPLACE_WITH_REAL_SECRET_KEY
