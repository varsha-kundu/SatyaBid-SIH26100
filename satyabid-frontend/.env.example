# Frontend environment variables for SatyaBid.
# Copy this file to .env and fill in real values.
# Do NOT commit .env to source control.

# The deployed Render backend URL. No trailing slash.
VITE_API_BASE_URL=https://satyabid-gem.onrender.com

# Must match the API_KEY value set in Render → Environment Variables.
VITE_API_KEY=REPLACE_WITH_REAL_SECRET_KEY
